# ============ 必填配置 ============

# Claude API Key (从 https://console.anthropic.com/ 获取)
# 临时可以用假Key先跑起来,后续替换
CLAUDE_API_KEY=sk-ant-api03-placeholder-key-for-testing

# ============ 可选配置 (有默认值) ============

# 数据库密码 (随便设)
POSTGRES_PASSWORD=MyNexus2026

# 调试模式
DEBUG=false

# ============ 后续可扩展 (现在不用填) ============

# Qwen 通义千问 (后期切换用)
# QWEN_API_KEY=sk-xxxxxx
# QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-max-latest
# USE_QWEN=false

# 视觉(多模态)模型 —— 用户发图片时切到它(功能1: 让 Hiyori 能看见)
# 仅在 USE_QWEN=true 时生效, 需用支持图片的 VL 模型
# QWEN_VL_MODEL=qwen-vl-max-latest

# 嵌入(向量)模型 —— 长期记忆的真实语义检索(功能4)
# 配了 QWEN_API_KEY 即自动启用; 没配则降级到 hash 占位向量
# EMBED_MODEL=text-embedding-v3
# EMBED_DIM=1024

# ============ 联网搜索 (可选,Hiyori 才能查新闻/实时信息) ============

# 博查 AI Search (推荐, 国内服务, 免费 1000 次/月)
# 申请地址: https://open.bochaai.com/
# BOCHA_API_KEY=sk-xxxxxx

# Tavily AI Search (国际备用, 免费 1000 次/月)
# 申请地址: https://tavily.com/
# TAVILY_API_KEY=tvly-xxxxxx
